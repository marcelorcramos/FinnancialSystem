ENVIRONMENT=dev
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://finance:finance_dev@localhost:5544/finance
REDIS_URL=redis://localhost:6379/0
RABBITMQ_URL=amqp://finance:finance_dev@localhost:5672/
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-secret-key-change-me-0123456789abcdef
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
CORS_ORIGINS=http://localhost:4200
FRONTEND_URL=http://localhost:4200
# Mailpit in dev (UI on http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM="FinnancialSystem <no-reply@finnancial.local>"
# SeaweedFS S3 (credentials in deploy/seaweedfs/s3.json)
S3_ENDPOINT_URL=http://localhost:8333
S3_ACCESS_KEY=finance
S3_SECRET_KEY=finance_dev_secret
S3_BUCKET=finnancial
