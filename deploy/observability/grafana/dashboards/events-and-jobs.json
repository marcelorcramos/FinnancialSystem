        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (task, outcome) (rate(celery_tasks_total[5m]))",
          "legendFormat": "{{task}} {{outcome}}",
          "refId": "A"
