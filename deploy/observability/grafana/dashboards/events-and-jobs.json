      "id": 14
    },
    {
      "type": "logs",
      "title": "Background warnings and errors",
      "description": "Relay, consumers, worker and beat.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{service=~\"relay|worker|beat|consumer-.+\", level=~\"warning|error|critical\"}",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none"
      },
      "gridPos": {
        "x": 0,
