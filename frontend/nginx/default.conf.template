server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    server_tokens off;
    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    # Resolve the API host per request, so nginx starts even if it is not up yet.
    resolver ${NGINX_RESOLVER} valid=30s ipv6=off;
    set $api_upstream ${API_UPSTREAM};

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 'ok';
    }

    # Same-origin API keeps the refresh_token cookie (Path=/api/v1/auth) first-party.
    location /api/ {
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Hashed bundles never change.
    location ~* \.(?:js|css|woff2?|ttf|ico|png|svg|webp)$ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # SPA: unknown paths fall back to index.html, which is never cached.
    location / {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}
